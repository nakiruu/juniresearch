{"company_overview":{"as_of_utc_timestamp":"2026-09-14T22:20:03.528951Z","company_name":"AT&T Inc.","industry":"Telecommunications Services","sector":"Communication Services","ceo":"John T. Stankey","market_cap":181759644750,"currency":"USD","exchange":"NYSE","country":"US","website":"https://www.att.com","full_time_employees":133030,"ipo_date":"1983-11-21","beta":0.417,"isin":"US00206R1023","cusip":"00206R102","cik":"0000732717","price":26.525,"change":0.465,"change_percentage":1.78434,"volume":37512934,"timestamp":"2026-09-14T19:59:59Z","average_volume":54430694,"description":"Globally, AT&T Inc. delivers an array of telecommunication, media, and technology offerings. Within its Communications division, the company supplies wireless voice and data communication services. It also markets mobile devices, such as smartphones, wireless data access cards, and portable computing gadgets, alongside accessories like protective cases and hands-free equipment. These products are distributed through AT&T's proprietary outlets, authorized agents, and external retail partners. Furthermore, this segment caters to a broad clientele including multinational corporations, small-to-medium-sized enterprises, government entities, and wholesale clients. For these customers, it delivers an extensive suite of services encompassing data, voice connectivity, cybersecurity, cloud-based solutions, outsourcing, and both managed and professional services, in addition to client-side equipment. Residential consumers also benefit from this division's provision of high-speed fiber optic internet and traditional landline telephone services. Its communication-related offerings and merchandise are promoted under well-known brand names such as AT&T, Cricket, AT&T PREPAID, and AT&T Fiber. The Latin America segment is responsible for delivering wireless communication services within Mexico, as well as video entertainment services across the wider Latin American region. These services and products are branded as AT&T and Unefon. Established in 1983 and headquartered in Dallas, Texas, the corporation was previously known as SBC Communications Inc. and officially adopted the name AT&T Inc. in 2005.","description_source":"fmp","source":{"id":"CA9FA3","name":"Corporate Fundamentals","provider_id":"FMP"}},"analyst_data":{"as_of_utc_timestamp":"2026-09-14T22:20:03.528951Z","price_targets":{"target_consensus":26.53,"target_median":27.5,"target_high":30,"target_low":20},"ratings":{"strong_buy":1,"buy":25,"hold":30,"sell":6,"strong_sell":0,"consensus":"Hold"},"source":{"id":"CA9FA3","name":"Corporate Fundamentals","provider_id":"FMP"}},"price_performance":{"current_market":{"current_price":26.525,"year_high":29.79,"year_low":19.89,"price_avg_50":23.8638,"price_avg_200":25.14455,"position_in_range":0.6702020202020201,"change":0.465,"change_percentage":1.78434,"market_cap":181759644750,"as_of":"2026-09-14T19:59:59Z"},"price_changes":[{"period":"1D","date":"2026-09-13","change_pct":1.78434},{"period":"5D","date":"2026-09-09","change_pct":4.34697},{"period":"1M","date":"2026-08-14","change_pct":6.5689},{"period":"3M","date":"2026-06-14","change_pct":12.4894},{"period":"6M","date":"2026-03-14","change_pct":-4.31097},{"period":"YTD","date":"2026-01-01","change_pct":6.78341},{"period":"1Y","date":"2025-09-14","change_pct":-10.44902}],"price_currency":"USD","source":{"id":"CA9FA3","name":"Corporate Fundamentals","provider_id":"FMP"}},"aftermarket_trades_quotes":{"trade":{"price":26.511,"trade_size":1,"traded_at":"2026-09-14T22:18:57Z"},"quote":{"bid_price":26.51,"bid_size":11400,"ask_price":26.55,"ask_size":13400,"volume":38423316,"quoted_at":"2026-09-14T22:17:54Z"},"source":{"id":"CA9FA3","name":"Corporate Fundamentals","provider_id":"FMP"}},"revenue_segmentation":{"geographic":{"2021-12-31":{"fiscal_year":2021,"period":"FY","reported_currency":"USD","region_segments":{"International":870000000,"Asia Pacific":2637000000,"Brazil":1486000000,"Europe":6079000000,"Mexico":3043000000,"