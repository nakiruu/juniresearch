EDGAR_CONTACT=you@example.com

# Broker selector: "alpaca-paper" (default, the paper test rig) or "schwab" (LIVE real-money trading).
# BROKER=alpaca-paper

# Alpaca PAPER trading. The alpaca-paper broker refuses any non-paper base URL.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Charles Schwab LIVE trading (BROKER=schwab). Register an app at developer.schwab.com for the
# client id/secret; run `npm run trade:auth` once to link the account and store tokens
# (data/trade/schwab-token.json, gitignored). The refresh token expires every ~7 days → re-run trade:auth.
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1

# Set to 1 to refuse every order submission (kill switch — applies to both brokers).
# TRADE_DISABLED=1

# Discord webhook for run notifications (orders, fills, goal book, cash, audit) and halt/auth alerts.
# Create one in a channel's Integrations settings. Unset → notifications are log-only. Best-effort:
# a Discord outage never fails a trade run.
# DISCORD_WEBHOOK_URL=

# In-app scheduler (instrumentation.ts). Unset → the container serves pages but never trades.
# Separate from TRADE_DISABLED so deploying the code never auto-arms trading.
# TRADE_SCHEDULER_ENABLED=1

# Bearer token for GET /api/trade/status (read-only status). Unset → the route returns 503.
# TRADE_STATUS_TOKEN=change-me
