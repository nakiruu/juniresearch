# Raw vendor/EDGAR captures are provenance: never convert line endings.
data/raw/** -text

# Shell scripts must stay LF — a CRLF shebang breaks on Linux ("bad interpreter").
*.sh text eol=lf

# Persisted SEC companyfacts responses (facts:free, D-9) are binary.
*.json.gz binary

# Grounding exceptions apply only when byte-equal to main's copy (git show emits LF), so never convert their line endings.
lib/synth/grounding-exceptions.json text eol=lf
